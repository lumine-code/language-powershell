{
  "name": "PowerShell",
  "scopeName": "source.powershell",
  "type": "tree-sitter",
  "parser": "tree-sitter-powershell",
  "injectionNames": ["powershell"],
  "fileTypes": ["ps1", "psm1", "psd1", "ps1xml", "pssc", "psrc"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:airbus-cert/tree-sitter-powershell#v0.26.5",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "powershell.wasm",
    "highlightsQuery": "powershell-highlights.scm",
    "foldsQuery": "powershell-folds.scm",
    "indentsQuery": "powershell-indents.scm",
    "tagsQuery": "powershell-tags.scm",
    "localsQuery": "powershell-locals.scm"
  }
}
