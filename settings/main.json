{
  ".source.powershell": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"]
    },
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#",
        "block": ["<#", "#>"]
      },
      "nonWordCharacters": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?…"
    }
  }
}
